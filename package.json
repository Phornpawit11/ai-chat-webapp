{
  "name": "ai-chat-webapp",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "@types/bun": "^1.3.4",
      "@cloudflare/workers-types": "^4.20251213.0",
      "hono": "^4.8.2",
      "@trpc/server": "^11.7.2",
      "better-auth": "1.5.2",
      "ai": "^6.0.3",
      "lucide-react": "^0.546.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.3",
      "react-dom": "^19.2.3",
      "sonner": "^2.0.5",
      "@trpc/client": "^11.7.2",
      "@types/react": "^19.2.10",
      "@types/react-dom": "^19.2.3",
      "tailwindcss": "^4.1.18",
      "alchemy": "^0.87.0"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F server dev",
    "db:push": "turbo -F @ai-chat-webapp/db db:push",
    "db:studio": "turbo -F @ai-chat-webapp/db db:studio",
    "db:generate": "turbo -F @ai-chat-webapp/db db:generate",
    "db:migrate": "turbo -F @ai-chat-webapp/db db:migrate",
    "db:start": "turbo -F @ai-chat-webapp/db db:start",
    "db:watch": "turbo -F @ai-chat-webapp/db db:watch",
    "db:stop": "turbo -F @ai-chat-webapp/db db:stop",
    "db:down": "turbo -F @ai-chat-webapp/db db:down",
    "deploy": "turbo -F @ai-chat-webapp/infra deploy",
    "destroy": "turbo -F @ai-chat-webapp/infra destroy"
  },
  "dependencies": {
    "@ai-chat-webapp/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@ai-chat-webapp/config": "workspace:*",
    "@cloudflare/workers-types": "catalog:",
    "@types/bun": "catalog:",
    "turbo": "^2.8.12",
    "typescript": "^5"
  },
  "packageManager": "bun@1.2.3"
}
